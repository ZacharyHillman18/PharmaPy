diff --git a/PharmaPy/xp.py b/PharmaPy/xp.py
new file mode 100644
index 0000000..6312cc8
--- /dev/null
+++ b/PharmaPy/xp.py
@@ -0,0 +1,63 @@
+﻿"""Array namespace for the RHS path: numpy, except that a call with a JAX
+tracer among its arguments goes to jax.numpy.
+
+Imported as `np` by the modules on the right-hand-side path, so numeric
+callers see plain numpy, unchanged, and a traced call is traced.
+"""
+import numpy as _np
+
+try:
+    import jax as _jax
+    import jax.numpy as _jnp
+except ImportError:  # numpy-only installs keep working
+    _jax = _jnp = None
+
+
+def is_traced(obj):
+    if _jax is None:
+        return False
+    if isinstance(obj, _jax.core.Tracer):
+        return True
+    if isinstance(obj, (list, tuple)):
+        return any(is_traced(o) for o in obj)
+    if isinstance(obj, dict):
+        return any(is_traced(o) for o in obj.values())
+    return False
+
+
+def __getattr__(name):
+    attr = getattr(_np, name)
+    if not callable(attr) or isinstance(attr, type) or _jnp is None:
+        return attr
+    jattr = getattr(_jnp, name, None)
+    if jattr is None:
+        return attr
+
+    def dispatch(*args, **kwargs):
+        if is_traced(args) or is_traced(kwargs):
+            return jattr(*args, **kwargs)
+        return attr(*args, **kwargs)
+
+    dispatch.__name__ = name
+    return dispatch
+
+
+def set_at(array, index, value):
+    """array[index] = value, returning the result.
+
+    numpy: writes into `array` in place and returns it, exactly as before.
+    traced: returns a new array (jax arrays are immutable), promoting a
+    numpy buffer that is about to receive a traced value.
+    """
+    if is_traced(array) or is_traced(value):
+        return _jnp.asarray(array).at[index].set(value)
+    array[index] = value
+    return array
+
+
+def add_at(array, index, value):
+    """array[index] += value, returning the result (see set_at)."""
+    if is_traced(array) or is_traced(value):
+        return _jnp.asarray(array).at[index].add(value)
+    array[index] += value
+    return array
